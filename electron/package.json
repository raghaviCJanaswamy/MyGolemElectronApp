{
  "name": "idepGolemPackage",
  "version": "1.0.0",
  "description": "MyGolemElectronApp with bundled R runtime",
  "private": true,
  "main": "electron/main.js",
  "author": "YOUR NAME <you@example.com>",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "24.13.3",
    "@electron/notarize": "^2.2.0"
  },
  "dependencies": {
  },
  "build": {
    "appId": "com.example.idepgolem",
    "productName": "MyGolemElectronApp",
    "directories": {
      "output": "release"
    },

    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],

  "asar": true,
  "afterPack": "node scripts/after-pack-fix-perms.js",
  "afterSign": "node scripts/macos-notarize.js",


  "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",

      "extraResources": [
        {
          "from": "resources/r-runtime/mac-${arch}",
          "to": "r-runtime/mac-${arch}",
          "filter": ["**/*"]
        }
      ]
  },

  "win": {
      "target": ["nsis"],
      "extraResources": [
        {
          "from": "resources/r-runtime/win-${arch}",
          "to": "r-runtime/win-${arch}",
          "filter": ["**/*"]
        }
      ]
  }
  }
}
